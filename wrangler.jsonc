{
  // Static-assets-only Worker (no server code): `npx wrangler deploy` uploads dist/.
  "name": "teest",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths so client-side routes (/runs/123) load on refresh.
    "not_found_handling": "single-page-application"
  }
}
